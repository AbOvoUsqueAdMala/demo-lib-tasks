{
  "request": {
    "method": "POST",
    "urlPath": "/kz/source/orders",
    "headers": {
      "Idempotency-Key": {
        "matches": ".+"
      }
    }
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "externalId": "{{jsonPath request.body '$.id'}}"
    },
    "transformers": [
      "response-template"
    ]
  }
}
