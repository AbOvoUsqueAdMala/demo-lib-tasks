<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>com.example</groupId>
    <artifactId>demo-project</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <properties>
        <java.version>21</java.version>
        <db-scheduler.version>16.12.0</db-scheduler.version>
        <wiremock.version>3.13.1</wiremock.version>
        <extension.kz.expected>true</extension.kz.expected>
        <extension.az.expected>true</extension.az.expected>
        <orders-extension-kz.version>1.0.0-SNAPSHOT</orders-extension-kz.version>
        <orders-extension-az.version>1.0.0-SNAPSHOT</orders-extension-az.version>
    </properties>
    <modules>
        <module>demo-app</module>
    </modules>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.github.kagkarlsson</groupId>
                <artifactId>db-scheduler-spring-boot-starter</artifactId>
                <version>${db-scheduler.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>orders-extension-kz</artifactId>
                <version>${orders-extension-kz.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>orders-extension-az</artifactId>
                <version>${orders-extension-az.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <extension.kz.expected>${extension.kz.expected}</extension.kz.expected>
                            <extension.az.expected>${extension.az.expected}</extension.az.expected>
                        </systemPropertyVariables>
                    </configuration>
                    <executions>
                        <execution>
                            <goals><goal>integration-test</goal><goal>verify</goal></goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
